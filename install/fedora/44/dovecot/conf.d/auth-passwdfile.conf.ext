passdb passwd {
  driver = passwd-file
  auth_username_format = %{user}
  passwd_file_path = /etc/exim/domains/%{domain}/passwd
  auth_allow_weak_schemes = yes
}

userdb passwd {
  driver = passwd-file
  auth_username_format = %{user}
  passwd_file_path = /etc/exim/domains/%{domain}/passwd
  fields {
#    mail_location = maildir:~/mail/%{domain}/%{user}
    mail_driver = mdbox
    mail_path = ~/mail/%{domain}/%{user}
    gid = dovenull
  }
}