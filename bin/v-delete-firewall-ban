#!/bin/bash
# info: delete firewall blocking rule
# options: IP [CHAIN]
#
# The function deletes blocking rule from system firewall


#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Importing system variables
source /etc/profile

# Argument definition
ip="$1"
chain="${2:,,*}"

# Defining absolute path for iptables and modprobe
fail2ban="/usr/bin/fail2ban-client"

# Includes
source "$VESTA/func/main.sh"
source "$VESTA/conf/vesta.conf"


#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '1' "$#" 'IP [CHAIN]'
is_format_valid 'ip' 'chain'
is_system_enabled "$FIREWALL_SYSTEM" 'FIREWALL_SYSTEM'


#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Checking ip in banlist
if [ "$($fail2ban banned "$ip")" == '[[]]' ]; then
    exit
fi

# Deleting ip from banlist
if [ -z "$chain" ] ; then
  $fail2ban unbanip "$ip"
else
  if $fail2ban get "$chain" banned "$ip" ; then
    $fail2ban set "$chain" unbanip "$ip" 2>/dev/null
  fi
fi

#----------------------------------------------------------#
#                       Vesta                              #
#----------------------------------------------------------#

# Logging
log_event "$OK" "$ARGUMENTS"

exit
