#!/bin/bash

# Vesta Valkey AUTH and User Management Script

#----------------------------------------------------------#
#                    Variable&Function                     #
#----------------------------------------------------------#

# Includes
source $VESTA/func/main.sh
source $VESTA/conf/vesta.conf

# Get Valkey AUTH password from config and set environment variable
if [ -z "$VALKEY_AUTH_PASSWORD" ]; then
    echo "Error: Valkey AUTH password not found in configuration"
    exit 1
fi

# Set Valkey CLI AUTH environment variable to avoid command line warnings
export VALKEYCLI_AUTH="$VALKEY_AUTH_PASSWORD"


#----------------------------------------------------------#
#                    AUTH Functions                        #
#----------------------------------------------------------#

# Test Valkey AUTH connection
test_valkey_auth() {
    valkey-cli ping >/dev/null 2>&1
    if [ $? -eq 0 ]; then
        return 0
    else
        return 1
    fi
}


#----------------------------------------------------------#
#                 Valkey User Management                    #
#----------------------------------------------------------#

# Create Valkey user with ACL (Valkey 6.0+)
create_valkey_user() {
    local username="$1"
    local password="$2"
    local permissions="${3:-+@all -@admin &${username}:* ~${username}:*}"

    if [ -z "$username" ] || [ -z "$password" ]; then
        echo "Error: Username and password required"
        exit 1
    fi

    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    # Create user with ACL
    valkey-cli ACL SETUSER "$username" on ">${password}" $permissions >/dev/null 2>&1
    check_result $? "Failed to create Valkey user: $username"
    valkey-cli ACL SAVE >/dev/null 2>&1
    check_result $? "Failed to save Valkey user: $username"

    # Store user metadata
    valkey-cli HMSET "vesta:valkey:users:$username" \
        "created" "$(date +%s)" \
        "permissions" "$permissions" \
        "status" "active" \
        "created_by" "${USER:-root}" >/dev/null 2>&1

    echo "Valkey user created successfully: $username"
    echo "Permissions: $permissions"
}

# Delete Valkey user
delete_valkey_user() {
    local username="$1"

    if [ -z "$username" ]; then
        echo "Error: Username required"
        exit 1
    fi

    if [ "$username" = "default" ]; then
        echo "Error: Cannot delete default Valkey user"
        exit 1
    fi

    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    # Delete ACL user
    valkey-cli ACL DELUSER "$username" >/dev/null 2>&1
    check_result $? "Failed to delete Valkey user: $username"
    valkey-cli ACL SAVE >/dev/null 2>&1
    check_result $? "Failed to save Valkey user: $username"

    # Remove user metadata
    valkey-cli DEL "vesta:valkey:users:$username" >/dev/null 2>&1

    echo "Valkey user deleted: $username"
}

# List Valkey users
list_valkey_users() {
    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    echo "Valkey Users:"
    echo "============"

    # List ACL users
    valkey-cli ACL LIST | while read acl_line; do
        if [ ! -z "$acl_line" ]; then
            username=$(echo "$acl_line" | grep -o 'user [^ ]*' | cut -d' ' -f2)
            status=$(echo "$acl_line" | grep -o '\(on\|off\)')

            if [ ! -z "$username" ]; then
                echo "User: $username"
                echo "  Status: $status"
                echo "  ACL: $acl_line"

                # Get metadata if available
                created=$(valkey-cli HGET "vesta:valkey:users:$username" "created" 2>/dev/null)
                if [ ! -z "$created" ] && [ "$created" != "(nil)" ]; then
                    created_date=$(date -d "@$created" 2>/dev/null || echo "Unknown")
                    permissions=$(valkey-cli HGET "vesta:valkey:users:$username" "permissions" 2>/dev/null)
                    key_pattern=$(valkey-cli HGET "vesta:valkey:users:$username" "key_pattern" 2>/dev/null)

                    echo "  Created: $created_date"
                    echo "  Permissions: $permissions"
                    echo "  Key Pattern: $key_pattern"
                fi
                echo "  ---"
            fi
        fi
    done
}

# Change Valkey user password
change_valkey_user_password() {
    local username="$1"
    local new_password="$2"

    if [ -z "$username" ] || [ -z "$new_password" ]; then
        echo "Error: Username and new password required"
        exit 1
    fi

    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    # Change ACL user password
    valkey-cli ACL SETUSER "$username" ">${new_password}" >/dev/null 2>&1
    check_result $? "Failed to change password for user: $username"

    # Update metadata
    valkey-cli HSET "vesta:valkey:users:$username" "password_changed" "$(date +%s)" >/dev/null 2>&1

    echo "Password changed successfully for user: $username"
}

# Enable/Disable Valkey user
toggle_valkey_user() {
    local username="$1"
    local action="$2"  # on or off

    if [ -z "$username" ] || [ -z "$action" ]; then
        echo "Error: Username and action (on/off) required"
        exit 1
    fi

    if [ "$action" != "on" ] && [ "$action" != "off" ]; then
        echo "Error: Action must be 'on' or 'off'"
        exit 1
    fi

    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    valkey-cli ACL SETUSER "$username" "$action" >/dev/null 2>&1
    check_result $? "Failed to $action user: $username"

    # Update metadata
    valkey-cli HSET "vesta:valkey:users:$username" \
        "status" "$action" \
        "status_changed" "$(date +%s)" >/dev/null 2>&1

    echo "User $username is now $action"
}

# Set Valkey user permissions
set_valkey_user_permissions() {
    local username="$1"
    local permissions="$2"
    local key_pattern="${3:-*}"

    if [ -z "$username" ] || [ -z "$permissions" ]; then
        echo "Error: Username and permissions required"
        exit 1
    fi

    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    # Reset user permissions and set new ones
    valkey-cli ACL SETUSER "$username" reset on ~"$key_pattern" $permissions >/dev/null 2>&1
    check_result $? "Failed to set permissions for user: $username"

    # Update metadata
    valkey-cli HMSET "vesta:valkey:users:$username" \
        "permissions" "$permissions" \
        "key_pattern" "$key_pattern" \
        "permissions_changed" "$(date +%s)" >/dev/null 2>&1

    echo "Permissions updated for user: $username"
    echo "New permissions: $permissions"
    echo "Key pattern: $key_pattern"
}

# Get Valkey user info
get_valkey_user_info() {
    local username="$1"

    if [ -z "$username" ]; then
        echo "Error: Username required"
        exit 1
    fi

    if ! test_valkey_auth; then
        echo "Error: Valkey AUTH failed"
        exit 1
    fi

    echo "Valkey User Information: $username"
    echo "================================="

    # Get ACL info
    acl_info=$(valkey-cli ACL GETUSER "$username" 2>/dev/null)
    if [ $? -eq 0 ]; then
        echo "ACL Information:"
        echo "$acl_info"
        echo ""
    fi

    # Get metadata
    created=$(valkey-cli HGET "vesta:valkey:users:$username" "created" 2>/dev/null)
    if [ ! -z "$created" ] && [ "$created" != "(nil)" ]; then
        echo "Metadata:"
        echo "  Created: $(date -d "@$created" 2>/dev/null || echo "Unknown")"
        echo "  Permissions: $(valkey-cli HGET "vesta:valkey:users:$username" "permissions" 2>/dev/null)"
        echo "  Key Pattern: $(valkey-cli HGET "vesta:valkey:users:$username" "key_pattern" 2>/dev/null)"
        echo "  Status: $(valkey-cli HGET "vesta:valkey:users:$username" "status" 2>/dev/null)"
        echo "  Created By: $(valkey-cli HGET "vesta:valkey:users:$username" "created_by" 2>/dev/null)"

        password_changed=$(valkey-cli HGET "vesta:valkey:users:$username" "password_changed" 2>/dev/null)
        if [ ! -z "$password_changed" ] && [ "$password_changed" != "(nil)" ]; then
            echo "  Password Changed: $(date -d "@$password_changed" 2>/dev/null || echo "Unknown")"
        fi

        status_changed=$(valkey-cli HGET "vesta:valkey:users:$username" "status_changed" 2>/dev/null)
        if [ ! -z "$status_changed" ] && [ "$status_changed" != "(nil)" ]; then
            echo "  Status Changed: $(date -d "@$status_changed" 2>/dev/null || echo "Unknown")"
        fi

        permissions_changed=$(valkey-cli HGET "vesta:valkey:users:$username" "permissions_changed" 2>/dev/null)
        if [ ! -z "$permissions_changed" ] && [ "$permissions_changed" != "(nil)" ]; then
            echo "  Permissions Changed: $(date -d "@$permissions_changed" 2>/dev/null || echo "Unknown")"
        fi
    else
        echo "No metadata found for user: $username"
    fi
}


##########
# Action #
##########
case "$1" in
    "create")
        create_valkey_user "$2" "$3" "$4" "$5"
        ;;
    "delete")
        delete_valkey_user "$2"
        ;;
    "list")
        list_valkey_users
        ;;
    "password")
        change_valkey_user_password "$2" "$3"
        ;;
    "suspend")
        toggle_valkey_user "$2" off
        ;;
    "unsuspend")
        toggle_valkey_user "$2" on
        ;;
    *)
        echo "Usage: $0 {create|delete|list|password|suspend|unsuspend|permissions|info|test}"
        echo ""
        echo "Commands:"
        echo "  create <username> <password> [permissions]"
        echo "  delete <username>"
        echo "  list"
        echo "  password <username> <new_password>"
        echo "  suspend <username>"
        echo "  unsuspend <username>"
        exit 1
        ;;
esac